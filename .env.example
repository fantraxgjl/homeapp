# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/homeapp.db"

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://homeassistant.local:3000"

# ─── Google OAuth (from Google Cloud Console) ─────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Enable the Google Calendar API
# 3. Create OAuth 2.0 Web credentials
# 4. Add authorised redirect URI: http://homeassistant.local:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Home Assistant ───────────────────────────────────────────────────────────
# Long-lived access token: HA profile → Security → Long-Lived Access Tokens
# These can also be set via the Settings page in the dashboard UI
HA_BASE_URL="http://homeassistant.local:8123"
HA_TOKEN=""

# ─── Weather (Open-Meteo — no API key required) ───────────────────────────────
# Latitude/longitude for your location. Can also be set via Settings → Weather.
WEATHER_LAT="51.5074"
WEATHER_LON="-0.1278"

# ─── Recipe extraction (Anthropic Claude AI) ─────────────────────────────────
# Optional: enables "Import from URL/PDF" in the Recipe Book.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
