# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/homeapp.db"

# ─── Google OAuth (from Google Cloud Console) ─────────────────────
# Enable Calendar API at https://console.cloud.google.com
# Create OAuth 2.0 credentials, add http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Home Assistant ───────────────────────────────────────────────
# Long-lived access token from HA profile → Security → Long-Lived Access Tokens
HA_BASE_URL="http://homeassistant.local:8123"
HA_TOKEN=""

# ─── Weather (Open-Meteo, no API key required) ────────────────────
WEATHER_LAT="51.5074"
WEATHER_LON="-0.1278"

# ─── Optional: external meal plan API ────────────────────────────
# Leave empty to use local SQLite meal plan
MEAL_PLAN_API_URL=""
